{
  "name": "start-engineer",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight Windows application launcher and process monitor.",
  "author": "EsspPao",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "start:build": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "package:win": "npm run build && electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.essppao.startengineer",
    "productName": "Start Engineer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "build/tray-icon.png", "to": "tray-icon.png" }
    ],
    "win": {
      "executableName": "Start Engineer",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Start Engineer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Start-Engineer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Start-Engineer-Portable-${version}.${ext}"
    }
  }
}
