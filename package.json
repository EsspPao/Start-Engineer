{
  "name": "start-engineer",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight Windows application launcher and process monitor.",
  "author": "EsspPao",
  "homepage": "https://github.com/EsspPao/Start-Engineer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EsspPao/Start-Engineer.git"
  },
  "bugs": {
    "url": "https://github.com/EsspPao/Start-Engineer/issues"
  },
  "keywords": ["windows", "launcher", "electron", "process-monitor", "desktop"],
  "engines": {
    "node": ">=22"
  },
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:helper": "node scripts/build-window-helper.mjs",
    "build": "npm run build:helper && tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "start:build": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "prepackage:win": "node scripts/close-running-app.mjs",
    "package:win": "npm run build && electron-builder --win nsis portable --publish never",
    "package:win:signed": "npm run build && electron-builder --win nsis portable --publish never --config.win.signAndEditExecutable=true",
    "release:checksums": "node scripts/write-checksums.mjs",
    "release:verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "release:prepare": "npm run release:verify && npm run package:win && npm run release:checksums"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.essppao.startengineer",
    "productName": "Start Engineer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "build/tray-icon.png", "to": "tray-icon.png" },
      { "from": "dist-native/window-focus-helper/win-x64", "to": "window-focus-helper/win-x64" }
    ],
    "win": {
      "executableName": "Start Engineer",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Start Engineer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Start-Engineer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Start-Engineer-Portable-${version}.${ext}"
    }
  }
}
