{
  "name": "start-engineer",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight Windows application launcher and process monitor.",
  "author": "EsspPao",
  "homepage": "https://github.com/EsspPao/Start-Engineer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EsspPao/Start-Engineer.git"
  },
  "bugs": {
    "url": "https://github.com/EsspPao/Start-Engineer/issues"
  },
  "keywords": [
    "windows",
    "launcher",
    "electron",
    "process-monitor",
    "desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "electron:install": "install-electron",
    "postinstall": "npm run electron:install",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:helper": "node scripts/build-window-helper.mjs",
    "smoke:helper": "node scripts/smoke-window-helper.mjs",
    "clean:build": "node scripts/clean-build-output.mjs",
    "clean:release": "node scripts/clean-release-output.mjs",
    "build": "npm run clean:build && npm run build:helper && tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json && node scripts/verify-build-artifacts.mjs",
    "start": "electron .",
    "start:build": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "prepackage:win": "node scripts/close-running-app.mjs",
    "package:win": "npm run build && npm run package:win:artifacts",
    "package:win:artifacts": "npm run clean:release && electron-builder --win nsis portable --x64 --publish never && npm run verify:footprint",
    "prepackage:win:signed": "node scripts/close-running-app.mjs",
    "package:win:signed": "npm run build && npm run package:win:artifacts:signed",
    "package:win:artifacts:signed": "npm run clean:release && electron-builder --win nsis portable --x64 --publish never --config.win.signAndEditExecutable=true && npm run verify:footprint",
    "verify:footprint": "node scripts/verify-package-footprint.mjs",
    "release:checksums": "node scripts/write-checksums.mjs",
    "release:verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "prerelease:prepare": "node scripts/close-running-app.mjs",
    "release:prepare": "npm run release:verify && npm run package:win:artifacts && npm run release:checksums"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.essppao.startengineer",
    "productName": "Start Engineer",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.*",
      "!dist-electron/**/*.spec.*",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "dist-native/window-focus-helper/win-x64",
        "to": "window-focus-helper/win-x64",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      }
    ],
    "win": {
      "executableName": "Start Engineer",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Start Engineer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Start-Engineer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Start-Engineer-Portable-${version}.${ext}"
    }
  }
}
